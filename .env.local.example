# ─── App URL (set this in Vercel → Project Settings → Environment Variables) ──
# Used by the QR code generator so the QR points to the right domain.
# On Vercel this is auto-set to your deployment URL, but set it explicitly for
# your production domain (e.g. https://huntch.co.il) once DNS is configured.
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# ─── WhatsApp Business API (Meta Cloud API) ───────────────────────────────────
# Get these from https://developers.facebook.com → your app → WhatsApp → API Setup

# Long-lived or system-user access token with whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=

# The Phone Number ID (not the phone number itself) from API Setup page
WHATSAPP_PHONE_NUMBER_ID=

# A secret string you choose — paste the same value into Meta's webhook config
WHATSAPP_VERIFY_TOKEN=huntch_webhook_secret

# ─── Production session store (replace in-memory Map for Vercel deployments) ──
# Uncomment and set when deploying: https://vercel.com/docs/storage/vercel-kv
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
