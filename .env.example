# ─────────────────────────────────────────────────────────────
# Huntch environment variables
# Copy this file to `.env.local` (git-ignored) and fill in real values.
# NEXT_PUBLIC_* are exposed to the browser. Everything else is server-only.
# See LAUNCH-RUNBOOK.md for where each value comes from.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (Step 2) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ server-only — never import this into a client component
SUPABASE_SERVICE_ROLE_KEY=

# ── Meta WhatsApp Cloud API (Step 1) ──
# Phone number ID from the WhatsApp "API Setup" page (test number to start)
META_WHATSAPP_PHONE_ID=
# Temporary 24h token to start; replace with a permanent System User token for production
META_WHATSAPP_TOKEN=
# A random string YOU invent — must match what you enter in the webhook config in Meta
META_WHATSAPP_VERIFY_TOKEN=
# App Secret (App → Settings → Basic) — used to verify webhook request signatures
META_APP_SECRET=
# Graph API version (override only if Meta deprecates the current one)
META_GRAPH_VERSION=v21.0

# ── Stripe (deferred — only when billing goes live) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
